#!/usr/bin/env nodejs

const { execFileSync } = require('child_process')

const app = process.argv[2]
if (!/^[a-z0-9-]+$/.test(app || '')) {
  console.error('Invalid app name')
  process.exit(1)
}

const keys = execFileSync('dokku', ['config:keys', '--merged', app], { encoding: 'utf8' })
  .trim().split('\n').filter(Boolean)
const config = {}
for (const key of keys) {
  if (!/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(key)) throw new Error('Invalid config key')
  // Dokku writes a final newline after the value; keep any newlines inside it.
  const output = execFileSync('dokku', ['config:get', app, key], { encoding: 'utf8' })
  config[key] = output.replace(/\n$/, '')
}
process.stdout.write(JSON.stringify(config))
